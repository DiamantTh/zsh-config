#!/usr/bin/env bash

CURRENT="`pwd`"

set -u
set -e

# Function to validate safe deletion
safe_delete() {
  local target=$1
  if [[ "$target" == "$HOME/"* ]]; then
    read -p "Are you sure you want to remove $target? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      rm -rf "$target"
      echo "Removed $target."
    else
      echo "Skipped $target."
    fi
  else
    echo "Unsafe deletion path: $target"
  fi
}

# Remove ~/.zsh
if [ -d ~/.zsh ]; then
  safe_delete ~/.zsh
fi

# Remove ~/.zshrc
if [ -f ~/.zshrc ]; then
  safe_delete ~/.zshrc
fi

# Remove ~/.dir_colors
if [ -L ~/.dir_colors ]; then
  safe_delete ~/.dir_colors
fi
